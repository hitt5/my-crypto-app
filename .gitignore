# Canonical ART for F-MCP-BOOTSTRAP-EVAL must be reviewable and deliverable.
# Keep unrelated local test-result trees ignored.
!docs/99.sdt/art/test-results/
docs/99.sdt/art/test-results/*
# Canonical structured Evidence is repository state, not an ephemeral test run.
# Keep feature directories traversable and track phase Evidence while leaving
# screenshots, traces, videos, and other bulky runner output ignored.
!docs/99.sdt/art/test-results/*/
docs/99.sdt/art/test-results/*/*
!docs/99.sdt/art/test-results/*/evidence-dd*.json
!docs/99.sdt/art/test-results/*/_history/
docs/99.sdt/art/test-results/*/_history/*
!docs/99.sdt/art/test-results/*/_history/evidence-dd*.json
!docs/99.sdt/art/test-results/F-MCP-BOOTSTRAP-EVAL/
